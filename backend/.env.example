# Copy to .env and adjust. NEVER commit real .env values.
APP_MODE=local
PORT=3000
DATABASE_URL=postgres://assistant:assistant_dev_password@localhost:5432/assistant
# 32-byte hex secrets (openssl rand -hex 32)
JWT_SECRET=dev_only_jwt_secret_change_me_0123456789abcdef0123456789abcdef
APP_SECRET=dev_only_app_secret_change_me_0123456789abcdef01234567890abc
DATA_DIR=./data
# Public sign-up (POST /api/auth/register). Off by default — create accounts
# with `cargo run -- add-user ...` instead.
REGISTRATION_ENABLED=false
RUST_LOG=info,tower_http=debug
# Directory containing the built frontend (SPA). Leave empty in dev (Vite serves it).
STATIC_DIR=

# ----- Object storage (attachments + artifacts) -----
# local (default): files under STORAGE_LOCAL_DIR (default {DATA_DIR}/files)
# s3: any S3-compatible API (AWS S3, MinIO, R2, …)
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./data/files
# Upload / artifact size cap in megabytes.
MAX_UPLOAD_MB=25
# Required when STORAGE_BACKEND=s3:
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=assistant
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# Allow plain HTTP endpoints (local MinIO etc.)
# S3_ALLOW_HTTP=true

# ----- Web search (SearXNG) -----
# Builtin `web_search` calls SearXNG with format=json. Empty = the tool returns
# a configuration error. Dev: `make docker-searxng` → http://localhost:8080
# In compose the app defaults to http://searxng:8080.
SEARXNG_URL=http://localhost:8080

# ----- WASM tool builder -----
# Absolute path to scripts/build-tool.sh. Build the image once with
# `make tool-builder`, then the backend runs:
#   TOOL_BUILDER_CMD <source-file> <output-wasm>
# The script runs `assistant-tool-builder` with --network none.
# TOOL_BUILDER_CMD=/absolute/path/to/scripts/build-tool.sh
